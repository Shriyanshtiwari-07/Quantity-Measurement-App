# Build output
target/
**/target/

# IDE metadata — Eclipse / STS
.settings/
.classpath
.factorypath
.project

# IDE metadata — IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# IDE metadata — VS Code
.vscode/

# OS artefacts
.DS_Store
Thumbs.db

# Java compiled output (should never reach VCS)
*.class
*.jar
*.war
*.ear
*.log

# H2 persistent database files (dev only)
data/*.mv.db
data/*.trace.db
data/*.ser

# Environment / secrets — never commit real credentials
.env
.env.*
!.env.example

# Local profile/property overrides (branch-specific/local runs)
**/application-local.properties
**/application-*.local.properties
**/application-secret.properties

# Runtime files
logs/
**/logs/
*.out
*.pid
hs_err_pid*
replay_pid*

# Merge/editor leftovers
*.orig
*.rej
*.swp
