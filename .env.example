# =============================================================================
# ENVIRONMENT VARIABLES — Quantity Measurement Backend (Spring Boot microservices)
# =============================================================================
#
# HOW TO USE:
#   cp .env.example .env        ← do this once, fill in your values
#   docker-compose up --build
#
# .env        → your local secrets file — NEVER commit it (add to .gitignore)
# .env.example → this file — safe to commit, contains no real secrets
#
# HOW ENV VARS REACH SPRING BOOT:
#   docker-compose.yml reads .env and injects each variable into the
#   container's OS environment. Spring Boot picks them up via ${VAR_NAME}
#   placeholders in application-prod.properties.
#   When running locally without Docker, export the vars or pass them as
#   JVM args: -DJWT_SECRET=... -DMAIL_USERNAME=...
#
# =============================================================================
# DATABASE
# =============================================================================

# MySQL credentials — used by the mysql container, user-service, and measurement-service
DB_USERNAME=appuser
DB_PASSWORD=change_me_strong_password

# Prod only: your AWS RDS endpoint (leave blank for local Docker; docker-compose.prod.yml uses it)
# Example: mydb.abc123.us-east-1.rds.amazonaws.com
RDS_ENDPOINT=

# =============================================================================
# JWT
# =============================================================================

# Generate a strong secret with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# =============================================================================
# EMAIL (Gmail SMTP)
# =============================================================================

# Your Gmail address
MAIL_USERNAME=your-email@gmail.com

# Gmail App Password (not your login password)
# Google Account → Security → 2-Step Verification → App Passwords → Generate
# Paste the 16-char password without spaces: xxxx xxxx xxxx xxxx
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# =============================================================================
# OAUTH2 — Google
# =============================================================================

# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# OAUTH2 — GitHub
# =============================================================================

# github.com → Settings → Developer settings → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# FRONTEND / CORS
# =============================================================================

# Origins the API gateway and user-service will accept requests from.
# Local:  http://localhost:5173
# Prod:   https://your-frontend.example.com  (comma-separated for multiple)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Where the browser is redirected after Google/GitHub OAuth2 login completes.
# Must match the Authorized Redirect URI registered in Google/GitHub console.
# Local:  http://localhost:5173/oauth2/callback
# Prod:   https://your-frontend.example.com/oauth2/callback
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback
